<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
        <RootNamespace>Drenalol.Telegram.Bot.Forms</RootNamespace>
        <AssemblyName>telegram-bot-forms</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <PackageId>Drenalol.Telegram.Bot.Forms</PackageId>
        <Title>Drenalol.Telegram.Bot.Forms</Title>
        <Authors>Bogdan Yanysh</Authors>
        <Version>1.2.1</Version>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>Telegram;Bot;Forms;Navigation;Dialog;Pagination;Telegram.Bot</PackageTags>
        <Description>Chat-first Telegram bot framework for Telegram.Bot: DI-scoped forms, per-chat navigation history with a Back action, paginated list forms, location and contact sharing, rich and ephemeral replies, free-text commands, per-chat localization and BotFather profile sync.</Description>
        <PackageProjectUrl>https://github.com/Drenalol/TelegramBotForms</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Drenalol/TelegramBotForms</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>© 2026 Bogdan Yanysh</Copyright>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Telegram.Bot" Version="22.10.4" />
        <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.1' ">
        <PackageReference Include="System.Text.Json" Version="10.0.12" />
        <PackageReference Include="System.Threading.Channels" Version="9.0.0" />
    </ItemGroup>

</Project>
